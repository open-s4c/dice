/* Configured slots provide strong handlers or register callback fallbacks.
 * Unknown slots register in the trailing callback phase. */
#ifndef DICE_MODULE_H
#define DICE_MODULE_H
void dice_require_abi(const char *configuration);
int dice_subscribe_abi(const char *configuration, chain_id chain, type_id type,
                      ps_callback_f callback, int slot);
#define ps_subscribe(CHAIN, TYPE, CB, SLOT) \
    dice_subscribe_abi(DICE_CONFIG_ID, CHAIN, TYPE, CB, SLOT)

#if defined(DICE_ROLL_RUNTIME) && !defined(DICE_MODULE_SLOT)
#define DICE_MODULE_SLOT 0
#endif
#ifndef DICE_MODULE_SLOT
#define DICE_MODULE_SLOT DICE_DEFAULT_PLUGIN_SLOT
#define DICE_IMPLICIT_SLOT
#define DICE_PLUGIN_MODULE
#endif

#define PS_ADVERTISE_TYPE(TYPE)
#define PS_ADVERTISE_CHAIN(CHAIN)
#define PS_DISPATCH_SLOT_ON(SLOT)
#define DICE_ROLL_JOIN_(A, B) A##B
#define DICE_ROLL_JOIN(A, B) DICE_ROLL_JOIN_(A, B)
#define DICE_ROLL_LOCAL(NAME) DICE_ROLL_JOIN(NAME, DICE_MODULE_SLOT)
#define DICE_SLOT_HANDLER(C, E, S) V_JOIN(V_JOIN(V_JOIN(dice_slot, C), E), S)
#define DICE_SLOT_ATTRIBUTES(S) DICE_ROLL_JOIN(DICE_SLOT_ATTRIBUTES_, S)
#define DICE_HANDLER_ATTRIBUTES(S) DICE_ROLL_JOIN(DICE_HANDLER_ATTRIBUTES_, S)
/* C's preceding prototype gives an inline definition external linkage. C++
 * instead makes it weak/COMDAT: omit its inline keyword to retain a strong
 * definition and duplicate-handler diagnostics in both languages. */
#ifdef __cplusplus
#define DICE_INLINE_SLOT_ __attribute__((always_inline))
#else
#define DICE_INLINE_SLOT_ inline __attribute__((always_inline))
#endif
#if defined(__cplusplus) && defined(__GNUC__) && !defined(__clang__)
/* GCC warns about always_inline without the C++ inline keyword even though
 * it honors the attribute. Limit suppression to the generated wrapper. */
#define DICE_SLOT_DIAGNOSTICS_BEGIN_ \
    _Pragma("GCC diagnostic push") \
    _Pragma("GCC diagnostic ignored \"-Wattributes\"")
#define DICE_SLOT_DIAGNOSTICS_END_ _Pragma("GCC diagnostic pop")
#else
#define DICE_SLOT_DIAGNOSTICS_BEGIN_
#define DICE_SLOT_DIAGNOSTICS_END_
#endif
/* Clang must fold publication selection before forcing the linked wrapper.
 * GCC otherwise leaves this private body behind as another out-of-line call. */
#if defined(__clang__)
#define DICE_INLINE_HANDLER_
#else
#define DICE_INLINE_HANDLER_ __attribute__((always_inline))
#endif
#define DICE_SLOT_BOUND(C, E, S) V_JOIN(V_JOIN(V_JOIN(dice_bound, C), E), S)
#define DICE_SUBSCRIBES(C, E, S) V_JOIN(V_JOIN(V_JOIN(dice_subscribes, C), E), S)

#if DICE_CALLBACKS
/* Registration must detect linked handlers without invoking user code. */
#define DICE_BIND_SLOT(C, E, S) \
    DICE_HIDE bool DICE_SLOT_BOUND(C, E, S)(void) { return true; }
#else
#define DICE_BIND_SLOT(C, E, S)
#endif

#if DICE_CHECK_ROUTES
/* A handler's explicit SLOT shadows this translation unit's default. */
#define DICE_ROUTE_SLOT dice_route_slot_
#ifdef DICE_IMPLICIT_SLOT
enum { DICE_ROUTE_SLOT = -1 };
#else
enum { DICE_ROUTE_SLOT = DICE_MODULE_SLOT };
#endif
#define DICE_ROUTE_CONTEXT(SLOT) enum { DICE_ROUTE_SLOT = (SLOT) };
enum ps_err dice_publish_checked(int slot, chain_id chain, type_id type,
                                void *event, struct metadata *md);
#define ps_publish(CHAIN, TYPE, EVENT, MD) \
    dice_publish_checked(DICE_ROUTE_SLOT, CHAIN, TYPE, EVENT, MD)
#define DICE_CHECK_SUBSCRIBES(CHAIN, TYPE, SLOT) \
    STATIC_ASSERT((DICE_EXTENSION_CALLBACKS && (SLOT) > DICE_LAST_KNOWN_SLOT) || \
                  DICE_ROUTE_SUBSCRIBES(SLOT, CHAIN, TYPE), \
                  "undeclared slot subscription");
#else
#define DICE_ROUTE_CONTEXT(SLOT)
#define DICE_CHECK_SUBSCRIBES(CHAIN, TYPE, SLOT)
#if defined(DICE_DISPATCH_MODULE) && !defined(DICE_PLUGIN_MODULE) && !defined(DICE_ROLL_RUNTIME) && DICE_ROLL_JOIN(DICE_STATIC_SLOT_, DICE_MODULE_SLOT)
/* Callback-free modules fold constant-chain routing at the publication site.
 * Dynamic chains retain the prioritized internal dispatcher. Direct ps_publish
 * calls and function pointers retain public validation. */
DICE_HIDE enum ps_err dice_publish_internal_(chain_id, type_id, void *,
                                             struct metadata *);
#undef PS_PUBLISH
#if DICE_ROLL_JOIN(DICE_INLINE_SLOT_FLAG_, DICE_MODULE_SLOT)
#define DICE_PUBLISH_INLINE_ dice_publish_inline_nested_
#else
#define DICE_PUBLISH_INLINE_ dice_publish_inline_
#endif
#if DICE_HEADER_DISPATCH
/* Explicit handler slots select their own publisher, even when they differ
 * from the translation unit's default. */
#undef DICE_ROUTE_CONTEXT
#define DICE_ROUTE_CONTEXT(SLOT) \
    ps_callback_f const dice_publish_context_ DICE_UNUSED = \
        DICE_ROLL_JOIN(DICE_SLOT_PUBLISHER_, SLOT);
#define PS_PUBLISH(CHAIN, TYPE, EVENT, MD) \
    PS_PUBLISH_WITH_((__builtin_constant_p(CHAIN) ? dice_publish_context_ : \
                     dice_publish_internal_), CHAIN, TYPE, EVENT, MD)
#else
#define PS_PUBLISH(CHAIN, TYPE, EVENT, MD) \
    PS_PUBLISH_WITH_(dice_publish_internal_, CHAIN, TYPE, EVENT, MD)
#endif
#endif
#endif

#ifndef DICE_ROLL_RUNTIME
static void DICE_CTOR dice_validate_header_(void)
{
    dice_require_abi(DICE_CONFIG_ID);
}
#endif

#if !defined(DICE_PLUGIN_MODULE) && (defined(DICE_DISPATCH_MODULE) || DICE_ROLL_JOIN(DICE_STATIC_SLOT_, DICE_MODULE_SLOT))
/* Keep strong wrappers, including for opted-in C++ handlers without LTO. */
#define PS_SUBSCRIBE_SLOT(CHAIN, TYPE, SLOT, ...) \
    STATIC_ASSERT(DICE_SUBSCRIBES(CHAIN, TYPE, SLOT), "undeclared slot subscription"); \
    DICE_BIND_SLOT(CHAIN, TYPE, SLOT) \
    static inline DICE_HANDLER_ATTRIBUTES(SLOT) enum ps_err PS_HANDLER(CHAIN, TYPE, SLOT)( \
        chain_id, type_id, void *, struct metadata *); \
    PS_HANDLER_DEF(CHAIN, TYPE, SLOT, DICE_ROUTE_CONTEXT(SLOT) __VA_ARGS__) \
    DICE_SLOT_DIAGNOSTICS_BEGIN_ \
    DICE_HIDE DICE_SLOT_ATTRIBUTES(SLOT) enum ps_err DICE_SLOT_HANDLER(CHAIN, TYPE, SLOT)( \
        chain_id chain, type_id type, void *event, struct metadata *md) \
    { return PS_HANDLER(CHAIN, TYPE, SLOT)(chain, type, event, md); } \
    DICE_SLOT_DIAGNOSTICS_END_
#define DICE_ROLL_CONSTRUCTOR()
#else
#define PS_SUBSCRIBE_SLOT(CHAIN, TYPE, SLOT, ...) \
    DICE_CHECK_SUBSCRIBES(CHAIN, TYPE, SLOT) \
    PS_HANDLER_DEF(CHAIN, TYPE, SLOT, DICE_ROUTE_CONTEXT(SLOT) __VA_ARGS__) \
    static void DICE_CTOR V_JOIN(PS_HANDLER(CHAIN, TYPE, SLOT), register_)(void) \
    { \
        int err = ps_subscribe(CHAIN, TYPE, PS_HANDLER(CHAIN, TYPE, SLOT), SLOT); \
        if (err != PS_OK) \
            log_fatal("could not subscribe plugin: %d", err); \
    }
#define DICE_ROLL_CONSTRUCTOR() \
    static void DICE_CTOR DICE_ROLL_LOCAL(module_ctor_)(void) \
    { \
        dice_require_abi(DICE_CONFIG_ID); \
        DICE_ROLL_LOCAL(module_init_)(); \
    }
#endif

#define PS_SUBSCRIBE(CHAIN, TYPE, ...) \
    PS_SUBSCRIBE_SLOT(CHAIN, TYPE, DICE_MODULE_SLOT, __VA_ARGS__)
#define DICE_MODULE_INIT(...) \
    static void DICE_ROLL_LOCAL(module_init_)(void) \
    { \
        static bool done; \
        if (!done) { \
            done = true; \
            do { __VA_ARGS__; } while (0); \
        } \
    } \
    PS_SUBSCRIBE(CHAIN_CONTROL, EVENT_DICE_INIT, { \
        DICE_ROLL_LOCAL(module_init_)(); \
    }) \
    DICE_ROLL_CONSTRUCTOR()
#define DICE_MODULE_FINI(...) \
    static void DICE_DTOR DICE_ROLL_LOCAL(module_fini_)(void) \
    { do { __VA_ARGS__; } while (0); }
#endif /* DICE_MODULE_H */
