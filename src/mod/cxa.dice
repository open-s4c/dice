(module cxa
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes (CHAIN_INTERCEPT_BEFORE EVENT_CXA_GUARD_ACQUIRE EVENT_CXA_GUARD_RELEASE
                EVENT_CXA_GUARD_ABORT)
            (CHAIN_INTERCEPT_AFTER EVENT_CXA_GUARD_ACQUIRE EVENT_CXA_GUARD_RELEASE
                EVENT_CXA_GUARD_ABORT)))
