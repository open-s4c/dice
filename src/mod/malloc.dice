(module malloc
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes (CHAIN_INTERCEPT_BEFORE EVENT_MALLOC EVENT_CALLOC EVENT_REALLOC
                EVENT_FREE EVENT_POSIX_MEMALIGN EVENT_ALIGNED_ALLOC
                EVENT_MALLOC_USABLE_SIZE)
            (CHAIN_INTERCEPT_AFTER EVENT_MALLOC EVENT_CALLOC EVENT_REALLOC
                EVENT_FREE EVENT_POSIX_MEMALIGN EVENT_ALIGNED_ALLOC
                EVENT_MALLOC_USABLE_SIZE)))
