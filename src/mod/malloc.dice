(module malloc
  (subscribes (CHAIN_CONTROL EVENT_DICE_INIT))
  (publishes (INTERCEPT_BEFORE EVENT_MALLOC EVENT_CALLOC EVENT_REALLOC
                EVENT_FREE EVENT_POSIX_MEMALIGN EVENT_ALIGNED_ALLOC)
            (INTERCEPT_AFTER EVENT_MALLOC EVENT_CALLOC EVENT_REALLOC
                EVENT_FREE EVENT_POSIX_MEMALIGN EVENT_ALIGNED_ALLOC)))
