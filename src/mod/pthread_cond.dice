(module pthread-cond
  (subscribes (CHAIN_CONTROL EVENT_DICE_INIT))
  (publishes (INTERCEPT_BEFORE EVENT_COND_WAIT EVENT_COND_TIMEDWAIT
                EVENT_COND_SIGNAL EVENT_COND_BROADCAST EVENT_COND_CLOCKWAIT)
            (INTERCEPT_AFTER EVENT_COND_WAIT EVENT_COND_TIMEDWAIT
                EVENT_COND_SIGNAL EVENT_COND_BROADCAST EVENT_COND_CLOCKWAIT)))
