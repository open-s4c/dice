(module pthread-create
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes (CHAIN_INTERCEPT_EVENT EVENT_THREAD_START EVENT_THREAD_EXIT)
            (CHAIN_INTERCEPT_BEFORE EVENT_THREAD_CREATE EVENT_THREAD_JOIN)
            (CHAIN_INTERCEPT_AFTER EVENT_THREAD_CREATE EVENT_THREAD_JOIN)))
