(module pthread-mutex
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes (CHAIN_INTERCEPT_BEFORE EVENT_MUTEX_LOCK EVENT_MUTEX_TIMEDLOCK
                EVENT_MUTEX_TRYLOCK EVENT_MUTEX_UNLOCK EVENT_MUTEX_CLOCKLOCK)
            (CHAIN_INTERCEPT_AFTER EVENT_MUTEX_LOCK EVENT_MUTEX_TIMEDLOCK
                EVENT_MUTEX_TRYLOCK EVENT_MUTEX_UNLOCK EVENT_MUTEX_CLOCKLOCK)))
