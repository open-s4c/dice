(module pthread-mutex
  (subscribes (CHAIN_CONTROL EVENT_DICE_INIT))
  (publishes (INTERCEPT_BEFORE EVENT_MUTEX_LOCK EVENT_MUTEX_TIMEDLOCK
                EVENT_MUTEX_TRYLOCK EVENT_MUTEX_UNLOCK EVENT_MUTEX_CLOCKLOCK)
            (INTERCEPT_AFTER EVENT_MUTEX_LOCK EVENT_MUTEX_TIMEDLOCK
                EVENT_MUTEX_TRYLOCK EVENT_MUTEX_UNLOCK EVENT_MUTEX_CLOCKLOCK)))
