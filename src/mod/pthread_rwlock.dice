(module pthread-rwlock
  (subscribes (CHAIN_CONTROL EVENT_DICE_INIT))
  (publishes (INTERCEPT_BEFORE EVENT_RWLOCK_RDLOCK EVENT_RWLOCK_TIMEDRDLOCK
                EVENT_RWLOCK_TRYRDLOCK EVENT_RWLOCK_WRLOCK
                EVENT_RWLOCK_TIMEDWRLOCK EVENT_RWLOCK_TRYWRLOCK
                EVENT_RWLOCK_UNLOCK)
            (INTERCEPT_AFTER EVENT_RWLOCK_RDLOCK EVENT_RWLOCK_TIMEDRDLOCK
                EVENT_RWLOCK_TRYRDLOCK EVENT_RWLOCK_WRLOCK
                EVENT_RWLOCK_TIMEDWRLOCK EVENT_RWLOCK_TRYWRLOCK
                EVENT_RWLOCK_UNLOCK)))
