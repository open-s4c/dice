(module self
  (option inline)
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT)
            (CHAIN_INTERCEPT_EVENT ANY_EVENT EVENT_THREAD_EXIT)
            (CHAIN_INTERCEPT_BEFORE ANY_EVENT)
            (CHAIN_INTERCEPT_AFTER ANY_EVENT))
  (publishes (CHAIN_CAPTURE_EVENT ANY_EVENT)
            (CHAIN_CAPTURE_BEFORE ANY_EVENT)
            (CHAIN_CAPTURE_AFTER ANY_EVENT)))
