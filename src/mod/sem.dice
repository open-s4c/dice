(module sem
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes (CHAIN_INTERCEPT_BEFORE EVENT_SEM_POST EVENT_SEM_WAIT EVENT_SEM_TRYWAIT
                EVENT_SEM_TIMEDWAIT)
            (CHAIN_INTERCEPT_AFTER EVENT_SEM_POST EVENT_SEM_WAIT EVENT_SEM_TRYWAIT
                EVENT_SEM_TIMEDWAIT)))
