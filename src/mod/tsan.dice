(module tsan
  (subscribes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (publishes (CHAIN_INTERCEPT_EVENT EVENT_MA_READ EVENT_MA_WRITE EVENT_MA_READ_RANGE
                EVENT_MA_WRITE_RANGE)
            (CHAIN_INTERCEPT_BEFORE EVENT_MA_AREAD EVENT_MA_AWRITE EVENT_MA_XCHG
                EVENT_MA_RMW EVENT_MA_CMPXCHG EVENT_MA_FENCE)
            (CHAIN_INTERCEPT_AFTER EVENT_MA_AREAD EVENT_MA_AWRITE EVENT_MA_XCHG
                EVENT_MA_RMW EVENT_MA_CMPXCHG EVENT_MA_FENCE)))
