(module tsan
  (subscribes (CHAIN_CONTROL EVENT_DICE_INIT))
  (publishes (INTERCEPT_EVENT EVENT_MA_READ EVENT_MA_WRITE EVENT_MA_READ_RANGE
                EVENT_MA_WRITE_RANGE)
            (INTERCEPT_BEFORE EVENT_MA_AREAD EVENT_MA_AWRITE EVENT_MA_XCHG
                EVENT_MA_RMW EVENT_MA_CMPXCHG EVENT_MA_FENCE)
            (INTERCEPT_AFTER EVENT_MA_AREAD EVENT_MA_AWRITE EVENT_MA_XCHG
                EVENT_MA_RMW EVENT_MA_CMPXCHG EVENT_MA_FENCE)))
