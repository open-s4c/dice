(dice (schema 1)
  (runtime (plugins true))
  (slot early (number 2)
    (consumes (CHAIN_FLOW EVENT_TEST ANY_EVENT)))
  (slot direct (number 4)
    (consumes (CHAIN_FLOW EVENT_TEST)))
  (slot middle (number 6)
    (consumes (CHAIN_FLOW ANY_EVENT)))
  (slot last (number 8)
    (consumes (CHAIN_FLOW EVENT_TEST ANY_EVENT)))
  ; A produces-only slot still contributes to the global dispatch boundary.
  (slot source (number 10)
    (produces (CHAIN_FLOW EVENT_TEST EVENT_OTHER)
              (CHAIN_OTHER EVENT_OTHER))))
