include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/core.cmake")
set(out "${WORK}/in-bounds")
file(MAKE_DIRECTORY "${out}")
roll_compile_flags(flags "${out}" DISPATCH)
foreach(maximum 200 60000)
  foreach(policy extension known none)
    set(callbacks false)
    if(policy STREQUAL "extension")
      set(callbacks true)
    endif()
    set(optional "")
    if(NOT policy STREQUAL "none")
      set(optional "(module registered (number 3)
        (callbacks true)
        (subscribes (CHAIN_FLOW EVENT_DICE_NOP ANY_EVENT)))")
    endif()
    file(WRITE "${out}/system.dice"
      "(callbacks ${callbacks}) (mempool-size 1Mi)
      (events (EVENT_HIGH ${maximum}))
      (module publisher (number 1) (publishes (CHAIN_FLOW ANY_EVENT)))
      (module linked (number 2) (callbacks false)
        (subscribes (CHAIN_FLOW EVENT_DICE_NOP ANY_EVENT)))
      ${optional}")
    run("${DICE}" "${out}/system.dice" -o "${out}")
    foreach(checked 0 1)
      roll_optimization_flags(build_flags optimized ${checked})
      build_core(core_objects "${out}/dice.c" ${build_flags})
      run("${CC}" ${build_flags} "${out}/dice.c" ${core_objects}
          "${FIXTURES}/in-bounds.c" ${link} -o "${out}/app")
      run("${out}/app")
    endforeach()
  endforeach()
endforeach()
