# Binary size suffixes produce the same bytes and fingerprint as plain counts.
foreach(pair "4Ki=4096" "200Mi=209715200" "2Gi=2147483648" "1Ti=1099511627776")
  string(REPLACE "=" ";" values "${pair}")
  list(GET values 0 size)
  list(GET values 1 bytes)
  file(WRITE "${root}/size.dice" "(callbacks false)\n(mempool-size ${size})\n")
  run("${DICE}" "${root}/size.dice" -o "${root}/size")
  file(READ "${root}/size/dice.h" size_header)
  string(FIND "${size_header}" "#define MEMPOOL_SIZE UINT64_C(${bytes})" position)
  if(position LESS 0)
    message(FATAL_ERROR "Wrong byte count for ${size}")
  endif()
  file(SHA256 "${root}/size/dice.c" size_c)
  file(SHA256 "${root}/size/dice.h" size_h)
  file(WRITE "${root}/bytes.dice" "(callbacks false)\n(mempool_size ${bytes})\n")
  run("${DICE}" "${root}/bytes.dice" -o "${root}/bytes")
  file(SHA256 "${root}/bytes/dice.c" bytes_c)
  file(SHA256 "${root}/bytes/dice.h" bytes_h)
  if(NOT size_c STREQUAL bytes_c OR NOT size_h STREQUAL bytes_h)
    message(FATAL_ERROR "Size spelling changed generated output for ${size}")
  endif()
endforeach()

