# Interceptors use the generated API, but their source is never in dice.c.
function(build_runtime library generated handlers)
  get_filename_component(directory "${generated}" DIRECTORY)
  get_filename_component(name "${generated}" NAME_WE)
  build_core(objects "${generated}" ${ARGN})
  foreach(module self pthread_create malloc)
    string(TOUPPER "${module}" slot)
    set(object "${directory}/${module}.o")
    run("${CC}" ${flags} ${ARGN} "-I${SOURCE}/include"
        "-I${SOURCE}/deps/libvsync/include" -include "${directory}/${name}.h"
        "-DDICE_MODULE_SLOT=SLOT_DICE_${slot}" -DDICE_DISPATCH_MODULE
        -c "${SOURCE}/src/mod/${module}.c" -o "${object}")
    list(APPEND objects "${object}")
  endforeach()
  run("${CC}" ${flags} ${ARGN} -DDICE_DISPATCH_MODULE ${shared} "${generated}" "${handlers}"
      ${objects} ${link} -o "${library}")
endfunction()

