  (include "aliases-events.dice")
  (runtime (mempool_size 209715200))
  (slot dice_self (before first-stage))
  (slot first_stage (after dice-self) (before last-stage)
    (consumes (CHAIN-FLOW EVENT-DATA ANY-EVENT)
              (CHAIN-DICE-CONTROL EVENT-DICE-INIT))
    (produces (CHAIN_FLOW EVENT_DATA)))
  (slot last_stage (after first-stage)
