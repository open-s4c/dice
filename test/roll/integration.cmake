# Reused pubsub core: initialization/reentrancy, sorted indexed callbacks and
# wildcard expansion with both dense IDs and sparse forced IDs near UINT16_MAX.
foreach(high_id 129 65534)
  foreach(callbacks true false)
    file(WRITE "${root}/pubsub.dice" "(schema 1)
      (callbacks ${callbacks})
      (events (EVENT_LOW 128) (EVENT_HIGH ${high_id}))
      (chains (CHAIN_LOW 7) (CHAIN_HIGH ${high_id}))
      (module initializer
        (subscribes (CHAIN_CONTROL EVENT_DICE_INIT EVENT_DICE_READY)
                  (CHAIN_LOW EVENT_LOW))
        (publishes (CHAIN_LOW EVENT_LOW)))")
    run("${DICE}" "${root}/pubsub.dice" -o "${out}")
    build_core(objects "${out}/dice.c")
    run("${CC}" ${flags} "${out}/dice.c" "${FIXTURES}/pubsub.c"
        ${objects} ${link} -o "${app}")
    run("${app}")
    assert_contains("${result_text}" "pubsub passed")
  endforeach()
endforeach()
# The same module source works with ordinary Dice includes and guarded IDs.
# Force-inclusion selects the generated API before any legacy header is read.
file(WRITE "${root}/compat.dice" "(schema 1)
  (module receiver (subscribes (CHAIN_COMPAT EVENT_COMPAT)
                           (CHAIN_CONTROL EVENT_DICE_INIT)))")
run("${DICE}" "${root}/compat.dice" -o "${out}")
set(compat_flags ${flags} "-I${SOURCE}/include"
    -include "${out}/dice.h" -DDICE_MODULE_SLOT=SLOT_RECEIVER)
run("${CC}" ${flags} -c "${out}/dice.c" -o "${out}/runtime.o")
build_core(objects "${out}/dice.c")
run("${CC}" ${compat_flags} ${shared} "${out}/runtime.o" ${objects}
    "${FIXTURES}/compat/subscriber.c" ${link} -o "${lib}")
run("${CC}" ${compat_flags} "${FIXTURES}/compat/main.c" "${lib}" ${link} -o "${app}")
run("${app}")
# Defining generated mode requires the generated configuration first.
file(GLOB headers "${SOURCE}/include/dice/events/*.h" "${SOURCE}/include/dice/chains/*.h")
file(WRITE "${out}/ids.c" "#include <dice/types.h>\n")
foreach(header IN LISTS headers)
  file(APPEND "${out}/ids.c" "#include \"${header}\"\n")
endforeach()
expect_failure("DICE_ROLLED requires dice/roll.h or generated dice.h first"
    "${CC}" -D_GNU_SOURCE -DDICE_ROLLED=1 -E -dM
    "-I${SOURCE}/include" "-I${SOURCE}/deps/libvsync/include" "${out}/ids.c")
# Compact event indexing must work with separately compiled modules and plugins.
file(WRITE "${root}/events.dice" "(events (EVENT_UNUSED 60000)) (chains (CHAIN_EMPTY 60000))\n")
run("${DICE}" "${root}/system.dice" -o "${out}")
build_runtime("${lib}" "${out}/dice.c" "${FIXTURES}/handlers.c")
run("${CC}" ${flags} ${shared} ${plugin_flags} "${FIXTURES}/plugin.c" -o "${mod}")
run("${CC}" ${flags} "${FIXTURES}/main.c" "${lib}" ${link} -o "${app}")
run("${app}")
run("${CMAKE_COMMAND}" -E env "${preload}=${lib}:${mod}" WITH_PLUGIN=1 "${app}")
# Sparse identifiers must also work in a sealed runtime.
string(REPLACE "(callbacks true)" "(callbacks false)" sealed_config "${config}")
file(WRITE "${root}/sealed-sparse.dice" "${sealed_config}")
run("${DICE}" "${root}/sealed-sparse.dice" -o "${out}")
build_runtime("${lib}" "${out}/dice.c" "${FIXTURES}/handlers.c")
run("${CC}" ${flags} "${FIXTURES}/main.c" "${lib}" ${link} -o "${app}")
run("${app}")
# Slot boundaries at INT_MAX must not wrap the default plugin slot negative.
file(WRITE "${root}/maximum.dice" "(schema 1) (module last (number 2147483647))")
run("${DICE}" "${root}/maximum.dice" -o "${out}")
file(WRITE "${out}/maximum.c" "#include \"dice.h\"\n#include <assert.h>\n
static enum ps_err cb(chain_id c, type_id t, void *e, struct metadata *m) {
  (void)c; (void)t; (void)e; (void)m; return PS_OK;
}
int main(void) {
  _Static_assert(DICE_LAST_KNOWN_SLOT == 2147483647, \"maximum slot\");
  assert(ps_subscribe(CHAIN_CONTROL, EVENT_DICE_NOP, cb, 2147483647) == PS_INVALID);
  assert(ps_subscribe(CHAIN_CONTROL, EVENT_DICE_NOP, cb, DICE_DEFAULT_PLUGIN_SLOT) == PS_INVALID);
}\n")
build_core(objects "${out}/dice.c")
run("${CC}" ${flags} "${out}/dice.c" "${out}/maximum.c"
    ${objects} ${link} -o "${app}")
run("${app}")
message(STATUS "roll: inferred IDs, ordering, sparse dispatch, plugins and route enforcement passed")
