    string(REPLACE "-" "_" spelling "${spelling}")
    string(REPLACE "aliases_events.dice" "aliases-events.dice" spelling "${spelling}")
  endif()
  file(WRITE "${root}/aliases.dice" "${spelling}")
  run("${DICE}" "${root}/aliases.dice" -o "${root}/aliases")
  file(SHA256 "${root}/aliases/dice.c" spelled_c)
