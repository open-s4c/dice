  run("${DICE}" --query "${root}/aliases.dice")
  if(NOT alias_c STREQUAL spelled_c OR NOT alias_h STREQUAL spelled_h
     OR NOT alias_query STREQUAL result_text)
    message(FATAL_ERROR "Hyphen and underscore spellings produced different configurations")
  endif()
