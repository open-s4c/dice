include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
set(out "${WORK}/priority-exact")
file(MAKE_DIRECTORY "${out}")
roll_compile_flags(flags "${out}" DISPATCH NO_CTOR)
foreach(order chains events implicit)
  set(chain CHAIN_TEST)
  if(order STREQUAL "chains")
    set(priority "(chains CHAIN_TEST) (events EVENT_TEST)")
  elseif(order STREQUAL "events")
    set(priority "(events EVENT_TEST) (chains CHAIN_TEST)")
  else()
    set(chain CAPTURE_EVENT)
    set(priority "(events EVENT_TEST)")
  endif()
  foreach(callbacks false true)
    file(
      WRITE "${out}/system.dice"
      "(callbacks ${callbacks})
      (prioritize ${priority})
      (module app (subscribes (${chain} EVENT_TEST)))")
    run("${DICE}" "${out}/system.dice" -o "${out}")
    # No ANY_EVENT handler remains after removing the preferred exact case.
    run("${CC}" ${flags} -c "${out}/dice.c" -o "${out}/dice.o")
  endforeach()
endforeach()
