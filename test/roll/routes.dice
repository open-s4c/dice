(schema 1)
  (include "interceptors.dice")
  (callbacks true)
  (module source
    (publishes (CHAIN_TEST EVENT_TEST)
              (CHAIN_WILD EVENT_TEST EVENT_OTHER)))
  (module first
    (before later)
    (subscribes (CHAIN_TEST EVENT_TEST))
    (publishes (CHAIN_MIDDLE EVENT_TEST)))
  (module later
    (subscribes (CHAIN_MIDDLE EVENT_TEST))
    (publishes (CHAIN_OUTPUT EVENT_TEST)))
  (module observer
    (subscribes (CHAIN_OUTPUT EVENT_TEST)
              (CAPTURE_BEFORE EVENT_MALLOC)
              (CAPTURE_EVENT EVENT_THREAD_START)))
  (module wildcard
    (subscribes (CHAIN_WILD ANY_EVENT))
    (publishes (CHAIN_OUTPUT ANY_EVENT)))
