(dice
  (schema 1)
  (include "../../examples/roll/interceptors.dice")
  (runtime (plugins true))
  (slot source
    (produces (CHAIN_TEST EVENT_TEST)
              (CHAIN_WILD EVENT_TEST EVENT_OTHER)))
  (slot first
    (before later)
    (consumes (CHAIN_TEST EVENT_TEST))
    (produces (CHAIN_MIDDLE EVENT_TEST)))
  (slot later
    (consumes (CHAIN_MIDDLE EVENT_TEST))
    (produces (CHAIN_OUTPUT EVENT_TEST)))
  (slot observer
    (consumes (CHAIN_OUTPUT EVENT_TEST)
              (CAPTURE_BEFORE EVENT_MALLOC)
              (CAPTURE_EVENT EVENT_THREAD_START)))
  (slot wildcard
    (consumes (CHAIN_WILD ANY_EVENT))
    (produces (CHAIN_OUTPUT ANY_EVENT))))
